generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider     = "postgresql"
  url          = env("POSTGRES_PRISMA_DIRECT_URL")
  directUrl    = env("POSTGRES_PRISMA_DIRECT_URL")
  relationMode = "prisma"
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "like_user_fk")

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "like_user_fk")

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @map("updated_at")
  lemonSqueezyCustomerId String?   @unique @map("lemon_squeezy_customer_id")
  lemonSqueezyLicenseKey String?   @unique @map("lemon_squeezy_license_key")
  lemonSqueezyOrderId    String?   @unique @map("lemon_squeezy_order_id")
  accounts               Account[]
  Chart                  Chart[]
  sessions               Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Chart {
  id          String   @id @default(cuid())
  /// [ChartConfigType]
  config      Json?
  aspectRatio String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  authorId    String
  watermark   Boolean  @default(true)
  author      User     @relation(fields: [authorId], references: [id], map: "like_author_fk")

  @@index([authorId], map: "charts_authorId_fkey")
  @@map("charts")
}
